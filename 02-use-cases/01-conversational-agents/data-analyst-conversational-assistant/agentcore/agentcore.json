{
  "name": "DataAnalyst",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "DataAnalystRuntime",
      "protocol": "HTTP",
      "build": "Container",
      "entrypoint": "app.py",
      "codeLocation": "cdk-data-analyst-assistant-agentcore-strands/data-analyst-assistant-agentcore-strands",
      "authorizerType": "AWS_IAM",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": true
      },
      "description": "Strands conversational data analyst; custom CDK owns infrastructure wiring",
      "dockerfile": "Dockerfile"
    }
  ],
  "memories": [
    {
      "name": "DataAnalystAssistantMemory",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "SEMANTIC",
          "name": "Facts",
          "namespaces": [
            "/facts/{actorId}"
          ]
        }
      ]
    }
  ],
  "agentCoreGateways": [],
  "evaluators": [],
  "credentials": []
}