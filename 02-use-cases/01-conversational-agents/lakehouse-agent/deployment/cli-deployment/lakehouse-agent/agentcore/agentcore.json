{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "LakehouseAgent",
  "version": 1,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "lakehouse_agent",
      "build": "Container",
      "codeLocation": "../../6-lakehouse-agent",
      "entrypoint": "lakehouse_agent.py",
      "protocol": "HTTP",
      "networkMode": "PUBLIC",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "allowedAudience": [
            "https://lakehouse-api"
          ],
          "discoveryUrl": "https://dev-a3xj8d6if5f4qnwz.us.auth0.com/.well-known/openid-configuration"
        }
      },
      "requestHeaderAllowlist": [
        "Authorization"
      ]
    }
  ],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": []
}