{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "opensearchmcpserver",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "opensearchmcpserver"
  },
  "runtimes": [
    {
      "name": "opensearch_mcp_server",
      "build": "CodeZip",
      "entrypoint": "server.py",
      "codeLocation": "./",
      "runtimeVersion": "PYTHON_3_10",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": true
      },
      "protocol": "MCP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://idp.placeholder.invalid/.well-known/openid-configuration",
          "allowedClients": [
            "__ALLOWED_CLIENT__"
          ]
        }
      },
      "executionRoleArn": "arn:aws:iam::000000000000:role/AgentCoreRuntimeRole-opensearch-mcp",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "__AWS_REGION__"
        },
        {
          "name": "OPENSEARCH_COLLECTION_ENDPOINT",
          "value": "__OPENSEARCH_COLLECTION_ENDPOINT__"
        },
        {
          "name": "LOG_LEVEL",
          "value": "DEBUG"
        },
        {
          "name": "IDP_PROVIDER",
          "value": "__IDP_PROVIDER__"
        }
      ],
      "tags": {
        "Application": "lakehouse-agent",
        "Purpose": "opensearch-mcp"
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
