{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "lakehousemcpserver",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "lakehousemcpserver"
  },
  "runtimes": [
    {
      "name": "lakehouse_mcp_server",
      "build": "CodeZip",
      "entrypoint": "server.py",
      "codeLocation": "./",
      "runtimeVersion": "PYTHON_3_10",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": true
      },
      "protocol": "MCP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://idp.placeholder.invalid/.well-known/openid-configuration",
          "allowedClients": [
            "__ALLOWED_CLIENT__"
          ]
        }
      },
      "executionRoleArn": "arn:aws:iam::000000000000:role/AgentCoreRuntimeRole-lakehouse-mcp",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "__AWS_REGION__"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "__S3_BUCKET_NAME__"
        },
        {
          "name": "ATHENA_DATABASE_NAME",
          "value": "__ATHENA_DATABASE_NAME__"
        },
        {
          "name": "LOG_LEVEL",
          "value": "DEBUG"
        },
        {
          "name": "CATALOG_NAME",
          "value": "__CATALOG_NAME__"
        }
      ],
      "tags": {
        "Application": "lakehouse-agent",
        "Purpose": "lakehouse-mcp"
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
