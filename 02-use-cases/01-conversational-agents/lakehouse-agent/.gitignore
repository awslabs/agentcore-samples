# AgentCore CLI project (agentcore/): deployer-specific state and build output.
# aws-targets.json carries the deploying account ID and is written by
# agentcore/deploy_runtimes.py at deploy time; .cli/ holds deployed ARNs.
agentcore/aws-targets.json
agentcore/.cli/
agentcore/.cache/
agentcore/.env.local
agentcore/*.zip
agentcore/*/staging/
agentcore/cdk/cdk.out/
agentcore/cdk/node_modules/
agentcore/cdk/dist/
# The repository-level lib/ rule would otherwise hide the CDK stack source.
!agentcore/cdk/lib/
