{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "lakehouseagent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "lakehouseagent"
  },
  "runtimes": [
    {
      "name": "lakehouse_mcp_server",
      "build": "CodeZip",
      "entrypoint": "server.py",
      "codeLocation": "deployment/4a-mcp-lakehouse-server/",
      "runtimeVersion": "PYTHON_3_10",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": true
      },
      "protocol": "MCP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://idp.placeholder.invalid/.well-known/openid-configuration",
          "allowedClients": [
            "__ALLOWED_CLIENT__"
          ]
        }
      },
      "executionRoleArn": "arn:aws:iam::000000000000:role/AgentCoreRuntimeRole-lakehouse-mcp",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "__AWS_REGION__"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "__S3_BUCKET_NAME__"
        },
        {
          "name": "ATHENA_DATABASE_NAME",
          "value": "__ATHENA_DATABASE_NAME__"
        },
        {
          "name": "LOG_LEVEL",
          "value": "DEBUG"
        },
        {
          "name": "CATALOG_NAME",
          "value": "__CATALOG_NAME__"
        }
      ],
      "tags": {
        "Application": "lakehouse-agent",
        "Purpose": "lakehouse-mcp"
      }
    },
    {
      "name": "opensearch_mcp_server",
      "build": "CodeZip",
      "entrypoint": "server.py",
      "codeLocation": "deployment/4b-mcp-opensearch-server/",
      "runtimeVersion": "PYTHON_3_10",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": true
      },
      "protocol": "MCP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://idp.placeholder.invalid/.well-known/openid-configuration",
          "allowedClients": [
            "__ALLOWED_CLIENT__"
          ]
        }
      },
      "executionRoleArn": "arn:aws:iam::000000000000:role/AgentCoreRuntimeRole-opensearch-mcp",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "__AWS_REGION__"
        },
        {
          "name": "OPENSEARCH_COLLECTION_ENDPOINT",
          "value": "__OPENSEARCH_COLLECTION_ENDPOINT__"
        },
        {
          "name": "LOG_LEVEL",
          "value": "DEBUG"
        },
        {
          "name": "IDP_PROVIDER",
          "value": "__IDP_PROVIDER__"
        }
      ],
      "tags": {
        "Application": "lakehouse-agent",
        "Purpose": "opensearch-mcp"
      }
    },
    {
      "name": "lakehouse_agent",
      "build": "CodeZip",
      "entrypoint": "lakehouse_agent.py",
      "codeLocation": "deployment/6-lakehouse-agent/",
      "runtimeVersion": "PYTHON_3_10",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://idp.placeholder.invalid/.well-known/openid-configuration",
          "allowedClients": [
            "__ALLOWED_CLIENT__"
          ]
        }
      },
      "instrumentation": {
        "enableOtel": true
      },
      "executionRoleArn": "arn:aws:iam::000000000000:role/AgentCoreRuntimeRole-lakehouse-agent",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "__AWS_REGION__"
        },
        {
          "name": "GATEWAY_ARN",
          "value": "__GATEWAY_ARN__"
        }
      ],
      "tags": {
        "Application": "lakehouse-agent",
        "Purpose": "lakehouse-agent"
      }
    }
  ],
