# Copy this file to `.env` IN THIS DIRECTORY (the sample root) and fill in the values.
# `deployment/.env` is also read; the loader prints which file it used and warns
# about any other .env it found but did not read.

# The IdP (cognito|okta) is chosen in notebook 01-deploy-idp.ipynb (Step 0), NOT here.

# Okta path only (IDP_PROVIDER=okta): the Okta setup reads these from .env.
#
# OKTA_API_TOKEN must be created by an admin whose role can manage
# AUTHORIZATION SERVERS, APPLICATIONS, GROUPS and USERS -- setup_okta.py writes to
# all four. Super Admin is the simple choice on a free Integrator tenant. There is
# no pre-flight permission check, so a narrower token fails partway through with a
# 403. The token is NOT removed by teardown (you created it, so the sample cannot
# revoke it) -- revoke it yourself at Security > API > Tokens when you are done.
# See deployment/1-okta-setup/README.md.
#
# OKTA_ORG_URL=dev-12345678.okta.com
# OKTA_API_TOKEN=

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
