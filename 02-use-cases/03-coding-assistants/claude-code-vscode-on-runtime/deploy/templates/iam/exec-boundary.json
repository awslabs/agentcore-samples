{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullTheBoxImageOnly",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:{{REGION}}:{{ACCOUNT_ID}}:repository/devbox-box"
    },
    {
      "Sid": "RegistrySignIn",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "BoxRuntimeLogsOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:DescribeLogStreams", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/bedrock-agentcore/runtimes/devbox_vm_*",
        "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/bedrock-agentcore/runtimes/devbox_vm_*:log-stream:*"
      ]
    },
    {
      "Sid": "FindLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:*"
    },
    {
      "Sid": "MountTheBoxFileSystemOnly",
      "Effect": "Allow",
      "Action": ["elasticfilesystem:ClientMount", "elasticfilesystem:ClientWrite"],
      "Resource": "{{FILE_SYSTEM_ARN}}"
    },
    {
      "Sid": "DescribeTheBoxFileSystemOnly",
      "Effect": "Allow",
      "Action": ["elasticfilesystem:DescribeAccessPoints", "elasticfilesystem:DescribeMountTargets"],
      "Resource": ["{{FILE_SYSTEM_ARN}}", "arn:aws:elasticfilesystem:{{REGION}}:{{ACCOUNT_ID}}:access-point/*"]
    }
  ]
}
