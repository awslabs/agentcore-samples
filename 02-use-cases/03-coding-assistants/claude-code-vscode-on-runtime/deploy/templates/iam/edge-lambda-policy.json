{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/lambda/devbox-edge"
    },
    {
      "Sid": "OwnLogStreams",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/lambda/devbox-edge:log-stream:*"
    }
  ]
}
