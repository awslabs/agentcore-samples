# Settings for devbox.py. Copy this file to devbox.env (git-ignored) and fill in your Okta domain;
# deploy prints the Okta steps, and the client id comes from the Dev Box app you create there. No secrets.
# Account IDs, the Identity Center instance and the identity store are looked up from the
# admin profiles, so they aren't listed here.

# Admin CLI profiles in your own ~/.aws/config (the script only reads it). The management account can also be
# the AI account, as in IDENTITY-SETUP.md.
ORG_ADMIN_PROFILE=org-admin          # management account: IAM Identity Center (people, start URL)
AI_ADMIN_PROFILE=ai-admin            # AI account: everything devbox.py creates

REGION=us-east-1                     # the box's allowlist and the browser config assume it
DEVBOX_AZ=us-east-1a                 # the one Availability Zone (box subnet, EFS mount target). Its zone id must be one
                                     # AgentCore microVM VPC mode supports: use1-az1, use1-az2 or use1-az4 (check verifies it)

# Each person's box: a microVM runtime devbox_vm_<name> (2 vCPU / 8 GB, arm64) in the box subnet, with their own
# folder /devbox/<name> on one EFS file system mounted at /mnt/workspace. microvm is the only value: deploy no
# longer makes Instances boxes; `retire-instances` deletes the old ones.
DEVBOX_COMPUTE=microvm
DEVBOX_IDLE_SECONDS=3600             # end a session after this long idle (at most 28800: a microVM lives 8 h); files stay on EFS

# Nobody is listed here: the groups decide. Everyone in DEVBOX_OKTA_GROUP gets a box the first time they
# open the workbench; the provisioner (POST /api/box) makes it. Their tier is the one tier group they're in: the same
# groups that grant the ClaudeCode-<tier> permission set in Identity Center, so the box's models and the person's AWS
# role always agree. In none, or in two, they get no box, and the page says why.
DEVBOX_TIER_GROUPS="Power=ai-claude-power Standard=ai-claude-standard"

# Okta: your org and its default authorization server (IDENTITY-SETUP.md)
OKTA_DOMAIN=                         # your Okta org, e.g. example.okta.com
OKTA_AUTH_SERVER=default
OKTA_AUDIENCE=api://default
DEVBOX_OKTA_GROUP=devbox-users            # who gets a box (an Okta group; the authorizers check it)
DEVBOX_OKTA_CLIENT_ID=                # the Dev Box SPA app's client id (public); blank until you create it

# IAM Identity Center (the sign-in inside the box). IDC_REGION also names the sign-in endpoints on the
# egress allowlist (oidc.<IDC_REGION>, portal.sso.<IDC_REGION>).
IDC_REGION=us-east-1
IDC_START_URL=                       # blank = https://<identity store id>.awsapps.com/start

# Models per tier (inference profile = GEO.MODEL): the same ones the permission sets allow (IDENTITY-SETUP.md, part 3)
GEO=us
OPUS_MODEL=anthropic.claude-opus-5
SONNET_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
HAIKU_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0

# Spike switches (OVERVIEW.md › Spike checklist; why each matters: deploy/README.md › Spike checklist)
FIREWALL_ENFORCE_DEFAULTS="aws:drop_established aws:alert_established"   # drop_strict would drop the handshake before the SNI
