# Optional deploy-time values. Helpers do NOT source this file automatically.
# Export reviewed values in your shell. Never put real credentials in source.
# Account/project/target/region are explicit CLI arguments (see README).

# Data destruction is true by default; retained data needs separate cleanup.
DESTROY_ON_DELETE=true
# KB_ID=approved-existing-kb-id
# SKIP_KB=true  # full E2E will not certify this omission

# Evaluation content is opt-in and for synthetic data only.
# IT_SAMPLE_EVALUATION_CONTENT=synthetic-only
# Transaction Search is read-only by default; account owner prepares it.
# TXN_SEARCH_ALLOW_MUTATION=true
# TXN_SEARCH_ACCOUNT_OWNER_APPROVAL=111111111111/us-west-2
# TXN_SEARCH_INDEXING_PERCENTAGE=100

# Configure Gateway JWT locally with scripts/enable-custom-jwt.sh before deploy.
# Provider, audience and actual token scopes are written to agentcore.json.

# Optional Jira: external same-account/region secret, no synth-time plaintext.
# JIRA_OAUTH_CLIENT_ID=registered-client-id
# JIRA_OAUTH_SECRET_ARN=arn:aws:secretsmanager:us-west-2:111111111111:secret:external-jira-abcdef
# JIRA_OAUTH_SECRET_VERSION_ID=00000000000000000000000000000000
# JIRA_OAUTH_SECRET_KMS_KEY_ARN=arn:aws:kms:us-west-2:111111111111:key/approved-key-id
# JIRA_SITE_URL=https://disposable-site.atlassian.net
# JIRA_CLOUD_ID=approved-site-cloud-uuid
# JIRA_PROJECT_KEY=INC
# JIRA_RUNTIME_USER_ID=U-1001
# JIRA_ALLOWED_TOOLS=actual_reviewed_jira_tool_names
# Complete user consent in an approved Identity integration, not through logs.
