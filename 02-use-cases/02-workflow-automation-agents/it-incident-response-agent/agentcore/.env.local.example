# Optional local runtime configuration for authorized development.
# CLI OAuth setup also stores credential secrets in agentcore/.env.local;
# protect that file, never commit/copy it into application assets or reports.
# Local invocation can make real AWS/IdP calls. Offline checks use /ping only.

AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6
FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
GATEWAY_AUTH_MODE=AWS_IAM
# GATEWAY_URL=https://your-owned-gateway/mcp
# MEMORY_ITINCIDENTAGENTMEMORY_ID=your-owned-memory-id
# GUARDRAIL_ID=your-owned-guardrail-id  # required for invocation
# GUARDRAIL_VERSION=DRAFT
# JWT settings must agree with the Gateway configuration:
# GATEWAY_AUTH_MODE=CUSTOM_JWT
# GATEWAY_OAUTH_PROVIDER_NAME=YourUniqueIT-gateway-m2m
# GATEWAY_OAUTH_AUDIENCE=your-api-audience
# GATEWAY_OAUTH_SCOPES=resolve:tickets
# Jira configuration/consent/tool approvals: docs/authentication-guide.md
