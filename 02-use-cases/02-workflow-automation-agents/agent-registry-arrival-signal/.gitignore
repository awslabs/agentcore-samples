# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# CDK synth output (regenerated by `cdk synth` / `agentcore deploy`) at any
# depth, covering the root app.py stack and both host projects' agentcore/cdk/ apps.
cdk.out/
**/cdk.out/
# AgentCore CLI per-project local state and secrets (never committed).
**/agentcore/.env.local
**/agentcore/.cli/
# AgentCore CLI generated read-only LLM-assistant context (regenerated by the CLI).
**/agentcore/.llm-context/

# Walkthrough output: the values file (deploy -> demo) and the result file.
# Both are account-specific and generated. The values file carries only
# non-secret ARNs, URLs, ids, and names, never credentials.
walkthrough-env.json
walkthrough-result.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
