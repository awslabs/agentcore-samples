@@ -0,0 +1,200 @@
+"""Unit tests for app/claimsagent/gateway_tools.py (Phase 3 direct Gateway calls).
+
+Payload shapes are copied from the production runtime log of the failed smoke test:
+``MCPClient.call_tool_async`` returns a plain dict, the text can be a JSON string
+that encodes JSON, and bare tool names come back as "Unknown tool".
+"""
+
+import asyncio
+import json
+import os
+import sys
+import unittest
+from types import SimpleNamespace
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "app", "claimsagent"))
+
+from gateway_tools import (  # noqa: E402
+    GATEWAY_TARGETS,
+    GatewayToolError,
+    default_gateway_name,
+    parse_tool_result,
+    resolve_tool_name,
+)
+
+_ROOT = os.path.join(os.path.dirname(__file__), "..")
+
+POLICY = {"policy_number": "POL-12345", "holder_name": "John Smith", "email": "john.smith@example.com"}
+
+# Exact production shape: the Lambda's json.dumps() output encoded again as a JSON string.
+DOUBLE_ENCODED_SUCCESS = {
+    "status": "success",
+    "toolUseId": "phase3-e4b667ac",
+    "content": [{"text": json.dumps(json.dumps(POLICY))}],
+}
+UNKNOWN_TOOL_ERROR = {
+    "status": "error",
+    "toolUseId": "phase3-c804dba2",
+    "content": [{"text": "Tool execution failed: Unknown tool: create_claim"}],
+}
+
+
+class ParseToolResultTests(unittest.TestCase):
+    def test_production_double_encoded_dict_result(self):
+        self.assertEqual(parse_tool_result(DOUBLE_ENCODED_SUCCESS), POLICY)
+
+    def test_single_encoded_dict_result(self):
+        result = {"status": "success", "toolUseId": "t", "content": [{"text": json.dumps(POLICY)}]}
+        self.assertEqual(parse_tool_result(result), POLICY)
+
+    def test_object_form_with_content_attribute(self):
+        result = SimpleNamespace(status="success", content=[SimpleNamespace(text=json.dumps(json.dumps(POLICY)))])
+        self.assertEqual(parse_tool_result(result), POLICY)
+
+    def test_tool_error_payload_is_returned_not_raised(self):
+        # A Lambda-level "not found" is a successful call with an error payload.
+        body = {"error": "Policy POL-00000 not found", "error_code": "POLICY_NOT_FOUND"}
+        result = {"status": "success", "toolUseId": "t", "content": [{"text": json.dumps(json.dumps(body))}]}
+        self.assertEqual(parse_tool_result(result), body)
+
+    def test_unknown_tool_status_error_raises(self):
+        with self.assertRaises(GatewayToolError) as ctx:
+            parse_tool_result(UNKNOWN_TOOL_ERROR)
+        self.assertIn("Unknown tool: create_claim", str(ctx.exception))
+
+    def test_is_error_flag_raises(self):
+        with self.assertRaises(GatewayToolError):
+            parse_tool_result({"isError": True, "content": [{"text": "boom"}]})
+
+    def test_non_json_text_returned_raw(self):
+        result = {"status": "success", "content": [{"text": "plain text"}]}
+        self.assertEqual(parse_tool_result(result), {"raw": "plain text"})
+
+    def test_empty_content(self):
+        self.assertIn("raw", parse_tool_result({"status": "success", "content": []}))
+
+
+class ResolveToolNameTests(unittest.TestCase):
+    LISTED = [
+        "policy-lookup___lookup_policy",
+        "create-claim___create_claim",
+        "human-review___request_human_review",
+        "notification___send_notification",
+    ]
+
+    def test_resolves_from_gateway_tool_list(self):
+        self.assertEqual(resolve_tool_name("create_claim", self.LISTED), "create-claim___create_claim")
+        self.assertEqual(resolve_tool_name("request_human_review", self.LISTED), "human-review___request_human_review")
+        self.assertEqual(resolve_tool_name("send_notification", self.LISTED), "notification___send_notification")
+
+    def test_falls_back_to_configured_target_when_list_unavailable(self):
+        self.assertEqual(resolve_tool_name("send_notification", None), "notification___send_notification")
+        self.assertEqual(resolve_tool_name("lookup_policy", []), "policy-lookup___lookup_policy")
+
+    def test_never_returns_bare_name_from_fallback(self):
+        for tool in GATEWAY_TARGETS:
+            self.assertIn("___", resolve_tool_name(tool, None))
+
+    def test_unknown_tool_raises(self):
+        with self.assertRaises(KeyError):
+            default_gateway_name("no_such_tool")
+
+
+class TargetConfigConsistencyTests(unittest.TestCase):
+    """GATEWAY_TARGETS must match agentcore/agentcore.json and the tool schemas."""
+
+    def test_matches_agentcore_config(self):
+        with open(os.path.join(_ROOT, "agentcore", "agentcore.json")) as f:
+            config = json.load(f)
+        expected = {}
+        for gateway in config["agentCoreGateways"]:
+            for target in gateway["targets"]:
+                schema_file = target["lambdaFunctionArn"]["toolSchemaFile"]
+                with open(os.path.join(_ROOT, schema_file)) as f:
+                    for tool in json.load(f):
+                        expected[tool["name"]] = target["name"]
+        self.assertTrue(expected, "no gateway targets found in agentcore.json")
+        self.assertEqual(GATEWAY_TARGETS, expected)
+
+
+try:
+    import main  # noqa: E402
+
+    _MAIN_AVAILABLE = True
+except Exception:  # agent SDKs not installed
+    _MAIN_AVAILABLE = False
+
+
+class FakeMCP:
+    """Stands in for strands MCPClient with the production result shapes."""
+
+    def __init__(self, listed_names, responses):
+        self.listed_names = listed_names
+        self.responses = responses
+        self.calls = []
+
+    def list_tools_sync(self, pagination_token=None):
+        return [SimpleNamespace(mcp_tool=SimpleNamespace(name=n)) for n in self.listed_names]
+
+    async def call_tool_async(self, tool_use_id, name, arguments):
+        self.calls.append(name)
+        if name not in self.listed_names:
+            return {
+                "status": "error",
+                "toolUseId": tool_use_id,
+                "content": [{"text": f"Tool execution failed: Unknown tool: {name}"}],
+            }
+        return self.responses[name]
+
+
+@unittest.skipUnless(_MAIN_AVAILABLE, "agent SDKs not installed (run under agent venv)")
+class CallToolIntegrationTests(unittest.TestCase):
+    def setUp(self):
+        main._gateway_tool_names = None
+        self.mcp = FakeMCP(
+            ResolveToolNameTests.LISTED,
+            {
+                "policy-lookup___lookup_policy": DOUBLE_ENCODED_SUCCESS,
+                "create-claim___create_claim": {
+                    "status": "success",
+                    "toolUseId": "t",
+                    "content": [{"text": json.dumps(json.dumps({"claim_id": "CLM-ABC12345"}))}],
+                },
+            },
+        )
+
+    def tearDown(self):
+        main._gateway_tool_names = None
+
+    def test_fetch_policy_returns_record_for_production_shape(self):
+        policy = asyncio.run(main._fetch_policy(self.mcp, "POL-12345"))
+        self.assertEqual(policy, POLICY)
+        self.assertEqual(self.mcp.calls, ["policy-lookup___lookup_policy"])
+
+    def test_create_claim_called_by_gateway_name(self):
+        result = asyncio.run(main._call_tool(self.mcp, "create_claim", {"policy_number": "POL-12345"}))
+        self.assertEqual(main._extract_claim_id(result), "CLM-ABC12345")
+        self.assertEqual(self.mcp.calls, ["create-claim___create_claim"])
+
+    def test_gateway_error_raises(self):
+        self.mcp.listed_names = []  # list empty -> fallback name, but the fake rejects it
+        with self.assertRaises(GatewayToolError):
+            asyncio.run(main._call_tool(self.mcp, "send_notification", {}))
+
+    def test_missing_claim_id_raises(self):
+        with self.assertRaises(GatewayToolError):
+            main._extract_claim_id({"error": "policy_number and description are required"})
+
+    def test_clean_fender_bender_auto_approves(self):
+        # Smoke-test replay: $2,000 auto_collision, matching email, policy re-fetched successfully.
+        from routing import AUTO_APPROVE, auto_approve_blockers, decide_action
+
+        policy = asyncio.run(main._fetch_policy(self.mcp, "POL-12345"))
+        decision = {"decision": "ACCEPT", "amount": 2000, "category": "auto_collision", "policy_number": "POL-12345"}
+        blockers = auto_approve_blockers(decision, "john.smith@example.com", policy)
+        self.assertEqual(blockers, [])
+        self.assertEqual(decide_action("ACCEPT", AUTO_APPROVE, blockers), AUTO_APPROVE)
+
+
+if __name__ == "__main__":
+    unittest.main()
