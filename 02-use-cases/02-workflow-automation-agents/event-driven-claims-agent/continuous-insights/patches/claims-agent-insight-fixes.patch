index 0000000..50eaf27
--- /dev/null
+++ b/app/claimsagent/gateway_tools.py
@@ -0,0 +1,106 @@
+"""Helpers for calling AgentCore Gateway tools directly from Phase 3 (no LLM).
+
+Two facts about the Gateway that Phase 3 must respect:
+
+1. Tool names. The Gateway exposes each Lambda tool as ``<target>___<tool>``
+   (e.g. ``policy-lookup___lookup_policy``), not by the bare schema name.
+   ``resolve_tool_name`` finds the real name in the client's tool list and falls
+   back to ``GATEWAY_TARGETS`` (which mirrors ``agentcore/agentcore.json``; a
+   unit test keeps the two in sync).
+
+2. Result shape. ``MCPClient.call_tool_async`` returns a plain dict
+   ``{"status", "toolUseId", "content": [{"text": ...}]}`` (Strands'
+   ``MCPToolResult``), and the text is often a JSON string that itself encodes
+   JSON, because the Lambda returns ``json.dumps(...)`` and the Gateway encodes
+   that string again. ``parse_tool_result`` handles the dict form, an object
+   with a ``.content`` attribute, and nested JSON encoding.
+"""
+
+import json
+
+# Bare tool name -> Gateway target name. Mirrors the targets in agentcore/agentcore.json.
+GATEWAY_TARGETS = {
+    "lookup_policy": "policy-lookup",
+    "create_claim": "create-claim",
+    "request_human_review": "human-review",
+    "send_notification": "notification",
+    "list_pending_claims": "list-pending-claims",
+    "resolve_claim": "resolve-claim",
+}
+
+TARGET_SEPARATOR = "___"
+
+# Lambda -> Gateway can stack JSON encodings; a small bound avoids looping on odd input.
+_MAX_JSON_DECODE_DEPTH = 3
+
+
+class GatewayToolError(RuntimeError):
+    """The Gateway reported that a tool call failed (status "error")."""
+
+
+def default_gateway_name(tool: str) -> str:
+    """Return ``<target>___<tool>`` from the static target map."""
+    target = GATEWAY_TARGETS.get(tool)
+    if target is None:
+        raise KeyError(f"No Gateway target configured for tool {tool!r}")
+    return f"{target}{TARGET_SEPARATOR}{tool}"
+
+
+def resolve_tool_name(tool: str, available_names: list[str] | None) -> str:
+    """Return the Gateway name for ``tool``.
+
+    Prefers a name the Gateway actually lists (exact match, or ``*___<tool>``);
+    falls back to the configured ``<target>___<tool>`` when the list is
+    unavailable or has no match.
+    """
+    for name in available_names or ():
+        if name == tool or name.endswith(f"{TARGET_SEPARATOR}{tool}"):
+            return name
+    return default_gateway_name(tool)
+
+
+def _decode_json(text):
+    """Decode ``text`` as JSON, unwrapping JSON strings that encode JSON."""
+    value = text
+    for _ in range(_MAX_JSON_DECODE_DEPTH):
+        if not isinstance(value, str):
+            return value
+        try:
+            value = json.loads(value)
+        except (json.JSONDecodeError, TypeError):
+            return value
+    return value
+
+
+def _field(result, name):
+    if isinstance(result, dict):
+        return result.get(name)
+    return getattr(result, name, None)
+
+
+def parse_tool_result(result) -> dict:
+    """Turn a Gateway tool result into the tool's JSON payload as a dict.
+
+    Raises ``GatewayToolError`` when the call itself failed (status "error",
+    e.g. "Unknown tool"). A tool's own error payload, such as
+    ``{"error": "Policy POL-1 not found"}``, is returned as a normal dict.
+    Text that is not a JSON object is returned as ``{"raw": text}``.
+    """
+    content = _field(result, "content") or []
+    texts = []
+    for block in content:
+        text = block.get("text") if isinstance(block, dict) else getattr(block, "text", None)
+        if text is not None:
+            texts.append(text)
+
+    status = str(_field(result, "status") or "").lower()
+    if status == "error" or _field(result, "isError") is True:
+        raise GatewayToolError(" ".join(str(t) for t in texts) or "Gateway tool call failed")
+
+    for text in texts:
+        payload = _decode_json(text)
+        if isinstance(payload, dict):
+            return payload
+    if texts:
+        return {"raw": texts[0]}
+    return {"raw": str(result)}
