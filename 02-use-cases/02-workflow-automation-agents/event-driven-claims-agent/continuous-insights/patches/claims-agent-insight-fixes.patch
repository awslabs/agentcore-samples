+class AutoApproveBlockerTests(unittest.TestCase):
+    def test_clean_claim_has_no_blockers(self):
+        self.assertEqual(auto_approve_blockers(CLEAN_DECISION, "john.smith@example.com", POLICY), [])
+
+    def test_high_value_blocks(self):
+        # Insight 77b4f99c001e4813: accepted claims above $25k never auto-approve.
+        blockers = auto_approve_blockers({**CLEAN_DECISION, "amount": 30000}, "john.smith@example.com", POLICY)
+        self.assertEqual(len(blockers), 1)
+        self.assertIn("High-value", blockers[0])
+
+    def test_threshold_amount_itself_is_not_high_value(self):
+        self.assertEqual(
+            auto_approve_blockers({**CLEAN_DECISION, "amount": 25000}, "john.smith@example.com", POLICY), []
+        )
+
+    def test_non_numeric_amount_blocks(self):
+        blockers = auto_approve_blockers({**CLEAN_DECISION, "amount": "lots"}, "john.smith@example.com", POLICY)
+        self.assertTrue(any("not a number" in b for b in blockers))
+
+    def test_unknown_category_blocks(self):
+        # Insight 79ec507ed6201827: an unconfirmed category cannot be auto-approved.
+        blockers = auto_approve_blockers({**CLEAN_DECISION, "category": "unknown"}, "john.smith@example.com", POLICY)
+        self.assertTrue(any("category" in b for b in blockers))
+
+    def test_missing_category_blocks(self):
+        decision = {k: v for k, v in CLEAN_DECISION.items() if k != "category"}
+        self.assertTrue(auto_approve_blockers(decision, "john.smith@example.com", POLICY))
+
+    def test_identity_mismatch_blocks(self):
+        blockers = auto_approve_blockers(CLEAN_DECISION, "stranger@example.com", POLICY)
+        self.assertTrue(any("does not match" in b for b in blockers))
+
+    def test_email_not_on_policy_session_routes_to_human_review(self):
+        # Replays ci-email-not-on-policy: processor ACCEPTs, validator AUTO_APPROVEs at 92.
+        blockers = auto_approve_blockers(CLEAN_DECISION, "stranger@example.com", POLICY)
+        _, routing = resolve_routing({"confidence": 92, "routing": "AUTO_APPROVE"}, "")
+        self.assertEqual(decide_action("ACCEPT", routing, blockers), HUMAN_REVIEW)
+
+    def test_large_house_fire_session_routes_to_human_review(self):
+        # Replays ci-large-house-fire: $30k ACCEPT, validator AUTO_APPROVEs at 92.
+        decision = {**CLEAN_DECISION, "amount": 30000, "category": "property_damage"}
+        blockers = auto_approve_blockers(decision, "john.smith@example.com", POLICY)
+        self.assertEqual(decide_action("ACCEPT", AUTO_APPROVE, blockers), HUMAN_REVIEW)
