# Nonsecret runtime settings for a directly launched LOCAL, cloud-connected process.
# The v1 lifecycle NEVER sources .env and refuses legacy .env state during fresh
# configuration. Use scripts/configure_target.py and docs/deployment.md instead.
# Never store a Cognito client secret here or inject one into the Runtime.
AWS_REGION=us-west-2
AGENTCORE_GATEWAY_URL=https://YOUR_OWNED_GATEWAY/mcp
AGENTCORE_GATEWAY_CREDENTIAL_PROVIDER=ClaimsYOURSUFFIX_dev_cognito-gateway-m2m
AGENTCORE_GATEWAY_OAUTH_SCOPES=agentcore/invoke
AGENT_MODEL_ID=global.anthropic.claude-sonnet-4-6
FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AUTO_APPROVE_THRESHOLD=80
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_RELEVANCE=0.5
# MEMORY_CLAIMSAGENTMEMORY_ID=YOUR_OWNED_MEMORY_ID
