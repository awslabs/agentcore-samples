# Environment for the agent — for local runs and to populate the deployed
# runtime's environment (these become the agentcore.json envVars).

AWS_REGION=us-east-1

# --- Okta ---
OKTA_ISSUER=https://your-tenant.okta.com
# The AI Agent (wlp...) id -- drives both token-exchange legs.
OKTA_CLIENT_ID=your-ai-agent-wlp-id

# --- The resource (Okta custom Authorization Server) ---
RESOURCE_AS_ISSUER=https://your-tenant.okta.com/oauth2/<as-id>
RESOURCE_API=api://todo

# How the agent reaches the resource API:
#   "lambda" -> call the resource Lambda via lambda:InvokeFunction (deployed default)
#   "http"   -> call RESOURCE_API_URL directly (local dev or a public HTTPS API)
RESOURCE_CALL_MODE=lambda
RESOURCE_LAMBDA_NAME=obo-todo-resource
# Only used when RESOURCE_CALL_MODE=http:
RESOURCE_API_URL=http://localhost:5001

XAA_SCOPES=todos.read

# --- AI Agent client authentication (private_key_jwt) ---
CLIENT_AUTH_METHOD=private_key_jwt
CLIENT_ASSERTION_ALG=RS256
OKTA_PRIVATE_KEY_KID=xaa-agent-okta
# Provide the signing key ONE of these ways:
#  - runtime (recommended): store the PEM in AWS Secrets Manager and set:
XAA_KEY_SECRET_ID=agentcore/xaa_private_key
#  - or mount a PEM file and set OKTA_PRIVATE_KEY_PATH instead:
# OKTA_PRIVATE_KEY_PATH=/app/keys/okta_private_key.pem
