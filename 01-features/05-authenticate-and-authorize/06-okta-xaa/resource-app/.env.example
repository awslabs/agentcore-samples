# The Okta custom Authorization Server (the "Resource AS") that issues the access
# tokens this API accepts. Its JWKS is at <issuer>/v1/keys. This is the issuer of
# the token produced by Leg 2 of the XAA ID-JAG flow.
# Example: https://your-tenant.okta.com/oauth2/aus1abc...
RESOURCE_AS_ISSUER=https://your-tenant.okta.com/oauth2/<as-id>

# The audience the access token must carry (the custom AS's configured audience).
RESOURCE_API=api://todo

PORT=5001
