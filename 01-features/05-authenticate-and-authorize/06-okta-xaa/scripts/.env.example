# === Okta Cross App Access (XAA / ID-JAG) — AI Agents model ===

# --- Okta org authorization server (mints the ID-JAG at Leg 1) ---
OKTA_ISSUER=https://your-tenant.okta.com

# --- okta_setup.py automation (Okta Management API; optional) ---
# Org base URL + an SSWS API token (Admin Console -> Security -> API -> Tokens).
OKTA_ORG_URL=https://your-tenant.okta.com
OKTA_API_TOKEN=

# --- Login app the user signs into (public PKCE => no secret) ---
# okta_setup.py can create this; copy its client id here.
OKTA_LOGIN_CLIENT_ID=your-login-oidc-client-id
OKTA_LOGIN_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8080/callback

# --- The AI Agent (Directory > AI Agents), a wlp... id ---
# Drives BOTH token-exchange legs, authenticating with its private_key_jwt key.
OKTA_CLIENT_ID=your-ai-agent-wlp-id

# --- The resource: an Okta custom Authorization Server ---
# Issuer (redeems the ID-JAG at Leg 2) + its audience, plus the HTTP base URL of
# the resource API to call in step 3.
RESOURCE_AS_ISSUER=https://your-tenant.okta.com/oauth2/<as-id>
RESOURCE_API=api://todo
RESOURCE_API_URL=http://localhost:5001

# Scopes to request through the flow (must be granted by the AS access policy).
XAA_SCOPES=todos.read

# --- AI Agent client authentication (private_key_jwt) ---
# The key registered on the AI Agent in Okta. Same key/kid is used for both legs.
CLIENT_AUTH_METHOD=private_key_jwt
CLIENT_ASSERTION_ALG=RS256
OKTA_PRIVATE_KEY_PATH=./keys/okta_private_key.pem
OKTA_PRIVATE_KEY_KID=xaa-agent-okta

# --- AgentCore Runtime deployment (agentcore CLI + deploy/patch_agentcore_json.py) ---
AWS_REGION=us-east-1
# How the DEPLOYED agent reaches the resource API:
#   "lambda" -> call the resource Lambda via lambda:InvokeFunction (no public URL)
#   "http"   -> call RESOURCE_API_URL directly (needs a reachable HTTPS endpoint)
RESOURCE_CALL_MODE=lambda
RESOURCE_LAMBDA_NAME=obo-todo-resource
# The AI Agent private key, stored in AWS Secrets Manager for the runtime to read.
XAA_KEY_SECRET_ID=agentcore/xaa_private_key
