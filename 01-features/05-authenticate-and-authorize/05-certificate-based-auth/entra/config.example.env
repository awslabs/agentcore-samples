# ── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Optional: override the AgentCore Identity endpoint URLs. Only needed
# if you are pointing at a non-default endpoint (for example, a private
# preview or a region-specific override). boto3 reads
# AWS_ENDPOINT_URL_<SERVICE> automatically at client construction time,
# so no code change is required.
# AWS_ENDPOINT_URL_BEDROCK_AGENTCORE_CONTROL=https://<endpoint>
# AWS_ENDPOINT_URL_BEDROCK_AGENTCORE=https://<endpoint>

# ── Entra ID tenant ────────────────────────────────────────────────────────
# The Azure AD / Entra tenant ID (GUID). Find under Microsoft Entra ID →
# Overview → Tenant ID. Also visible on any App Registration's Overview.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Microsoft Graph access token — Only required for the AUTOMATED setup
# path (setup/02, 02a, 02b, and the redirect-URI wiring in 04b). The
# setup scripts fetch this on demand via:
#   az account get-access-token --resource https://graph.microsoft.com
# No secret needs to live in .env. Prerequisite: `az login` once.
#
# If you'd rather configure Entra by hand, run:
#   python setup/print_manual_entra_instructions.py
# See README.md → "Manual Entra configuration" for details.

# Escape hatch for environments without Azure CLI: paste a Microsoft
# Graph bearer token here and setup/02, 02a, 02b, 04b, cleanup, and
# diagnose will use it instead of shelling out to `az`. Normally leave
# this blank and rely on `az login`.
# GRAPH_ACCESS_TOKEN=

# ── AgentCore identity ─────────────────────────────────────────────────────
# Names for the resources this sample creates. Change if you already have
# resources with the same names in your account/region.
WORKLOAD_NAME=pkjwt-entra-sample-workload
KMS_KEY_ALIAS=alias/pkjwt-entra-sample-signing-key
M2M_PROVIDER_NAME=pkjwt-entra-sample-m2m
OBO_PROVIDER_NAME=pkjwt-entra-sample-obo

# ── App labels ─────────────────────────────────────────────────────────────
# Names for the two Entra app registrations this sample creates.
# ENTRA_SERVICE_APP_LABEL=AgentCore Identity Private Key JWT Sample
# ENTRA_LOGIN_APP_LABEL=AgentCore Identity Private Key JWT Login App

# ── App role ──────────────────────────────────────────────────────────────
# The application-permission role added to the service app for M2M. The
# resulting downstream token carries roles=["m2m"].
# ENTRA_APP_ROLE_NAME=m2m

# ── OBO — browser 3LO for user JWT acquisition ────────────────────────────
# The OBO demo needs a user access token to exchange. get_entra_user_jwt.py
# runs the AgentCore-mediated 3LO flow: it opens your browser, you sign
# in with your real Entra account, and the user access token is written
# to ENTRA_USER_JWT below.
#
# Optional customisations:
# USER_ID_3LO=me
# LOCAL_CALLBACK_URL=http://localhost:8081/callback

# Optional: downstream scope for the OBO demo. Defaults to
# https://graph.microsoft.com/.default so the sample works out of the
# box against Microsoft Graph. Set this to your own API's .default
# scope if you want the OBO exchange to target something else.
# OBO_SCOPE=https://graph.microsoft.com/.default

# ── Populated by setup/02, 02a, 02b, 04b (do not edit by hand) ────────────
ENTRA_SERVICE_APP_OBJECT_ID=
ENTRA_SERVICE_CLIENT_ID=
ENTRA_SERVICE_SP_OBJECT_ID=
ENTRA_LOGIN_APP_OBJECT_ID=
ENTRA_LOGIN_CLIENT_ID=
CLIENT_PROVIDER_NAME=
AGENTCORE_MANAGED_CALLBACK_URL=

# ── Populated by setup/00 + setup/01 (do not edit by hand) ────────────────
# 00_provision_signing_key.py     writes SIGNING_KMS_KEY_ARN
# 01_build_certificate.py         writes X5T_S256_THUMBPRINT
#                                 (base64url of SHA-256(cert-DER))
SIGNING_KMS_KEY_ARN=
X5T_S256_THUMBPRINT=

# ── OBO-only ───────────────────────────────────────────────────────────────
# Populated by get_entra_user_jwt.py — the access token from the end
# user, used as the assertion in the RFC 7523 exchange. Leave blank until
# you run the browser 3LO step.
ENTRA_USER_JWT=
