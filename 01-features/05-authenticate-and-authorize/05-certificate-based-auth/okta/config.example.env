# ── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Optional: override the AgentCore Identity endpoint URLs. Only needed
# if you are pointing at a non-default endpoint (for example, a private
# preview or a region-specific override). boto3 reads
# AWS_ENDPOINT_URL_<SERVICE> automatically at client construction time,
# so no code change is required.
# AWS_ENDPOINT_URL_BEDROCK_AGENTCORE_CONTROL=https://<endpoint>
# AWS_ENDPOINT_URL_BEDROCK_AGENTCORE=https://<endpoint>

# ── Okta tenant ────────────────────────────────────────────────────────────
# App-facing Okta domain (NOT the -admin. host).
# Example: dev-12345678.okta.com
OKTA_DOMAIN=your-tenant.okta.com

# Okta authorization server ID. "default" for the built-in Custom AS,
# or the ID of a purpose-built AS you created.
OKTA_AUTH_SERVER_ID=default

# Okta admin API token (SSWS) with permission to create/update apps,
# scopes, and policies. SSWS is Okta's proprietary HTTP authentication
# scheme for static API tokens (sent as "Authorization: SSWS <token>").
# Only required for the AUTOMATED setup path
# (setup/01, 01a, 01b, and the redirect-URI wiring in 03b). If you'd
# rather configure Okta by hand, leave this blank and run:
#   python setup/print_manual_okta_instructions.py
# See README.md → "Manual Okta configuration" for details.
# Create the token under Security → API → Tokens.
OKTA_API_TOKEN=00...................................

# Optional: label to use when creating the Okta service app. Also used
# to look up an existing app on re-runs (setup step 01 is idempotent).
# Defaults to "AgentCore Identity Private Key JWT Sample".
# OKTA_SERVICE_APP_LABEL=AgentCore Identity Private Key JWT Sample

# ── AgentCore identity ─────────────────────────────────────────────────────
# Names for the resources this sample creates. Change if you already have
# resources with the same names in your account/region.
WORKLOAD_NAME=pkjwt-okta-sample-workload
KMS_KEY_ALIAS=alias/pkjwt-okta-sample-signing-key
M2M_PROVIDER_NAME=pkjwt-okta-sample-m2m
OBO_PROVIDER_NAME=pkjwt-okta-sample-obo

# The OAuth scope the M2M demo requests. On Okta's Custom AS you must
# register this scope (setup/01a does that automatically), and grant it
# via an Access Policy rule allowing the client_credentials grant type
# for your service app. Do NOT use 'openid' — Okta rejects it on the
# client_credentials grant.
M2M_SCOPE=api:access

# ── OBO — browser 3LO for user JWT acquisition ────────────────────────────
# The OBO demo needs a user access token as the subject_token in the
# RFC 8693 exchange. The setup pipeline creates a second Okta app (Web
# app, auth_code grant, PRIVATE_KEY_JWT) and a matching AgentCore
# Identity credential provider (USER_FEDERATION). get_okta_user_jwt.py
# runs the AgentCore-mediated 3LO flow: it opens your browser, you sign
# in with your real Okta account, and the user access token is written
# to OKTA_USER_JWT below.
#
# Optional customisations:
# OKTA_LOGIN_APP_LABEL=AgentCore Identity Private Key JWT Login App
# USER_ID_3LO=me
# LOCAL_CALLBACK_URL=http://localhost:8081/callback

# Okta login that should be granted access to the Web app. Some Okta
# tenants reject the built-in 'Everyone' group assignment via API on
# DCR-created apps (E0000001 / GroupAppAssignment), which surfaces at
# sign-in time as "You are not allowed to access this app". Setting
# OKTA_ASSIGN_USER_LOGIN makes setup/01b explicitly assign that user to
# the Web app, which works on every tenant.
# OKTA_ASSIGN_USER_LOGIN=you@example.com

# ── Populated by setup/01b + setup/03b (do not edit by hand) ──────────────
OKTA_LOGIN_APP_ID=
OKTA_LOGIN_APP_CLIENT_ID=
CLIENT_PROVIDER_NAME=
AGENTCORE_MANAGED_CALLBACK_URL=

# ── Populated by setup scripts (do not edit by hand) ───────────────────────
# 00_provision_signing_key.py       writes SIGNING_KMS_KEY_ARN
# 01_create_okta_service_app.py     writes OKTA_SERVICE_APP_ID,
#                                   OKTA_SERVICE_APP_CLIENT_ID, and
#                                   SIGNING_KID (from the JWK's derived kid)
#
# Setup step 01 uses Okta's Dynamic Client Registration endpoint
# (POST /oauth2/v1/clients) to create the service app and register the
# KMS public key as a JWK in one atomic call. If an app with
# OKTA_SERVICE_APP_LABEL already exists, the script reuses it.
SIGNING_KMS_KEY_ARN=
OKTA_SERVICE_APP_ID=
OKTA_SERVICE_APP_CLIENT_ID=
SIGNING_KID=

# ── OBO-only ───────────────────────────────────────────────────────────────
# Populated by the login flow in outbound_private_key_jwt_obo.py — the ID
# token or access token from the end user, used as subject_token in the
# RFC 8693 exchange. Leave blank until you run the login step.
OKTA_USER_JWT=
