# ─────────────────────────────────────────────────────────────────────────────
# Okta delegation chain: OBO to the gateway, XAA (ID-JAG) to the API
#
#   cp config.example.env .env
#
# Values marked SET ME you provide. Everything under "populated by …" is written
# back by the deploy scripts — leave those blank.
#
# .env and .env.* are gitignored and hold plaintext secrets, including an Okta
# admin API token. config.example.env is the tracked template.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ──────────────────────────────────────────────────────────────────────
# SET ME. Must be a region with AgentCore Gateway + Runtime + policy engine.
AWS_REGION=us-west-2

# ── Okta tenant ──────────────────────────────────────────────────────────────
# SET ME (both) — this is the minimum needed to run spike 2 and the 00_* script.
#
#   OKTA_ORG_URL: the APP-facing host, no trailing slash, NOT the -admin host.
#     Admin console https://integrator-1234567-admin.okta.com/...
#       -> OKTA_ORG_URL=https://integrator-1234567.okta.com
#     This is also the ORG authorization server, which is the only server that
#     MINTS an ID-JAG (leg 1). Do not put a /oauth2/... path here.
#
#   OKTA_API_TOKEN: Security -> API -> Tokens -> Create Token. Needs Org or
#     Super Admin. Used ONLY by deploy/00_create_okta_apps.py and the spike
#     scripts — never at runtime. Okta expires these after 30 days of inactivity.
OKTA_ORG_URL=
OKTA_API_TOKEN=

# The tenant must have Cross App Access / AI Agents enabled — often listed as
# "Agent to Agent Connections" under Settings -> Features. Without it, leg 1
# fails with `requested_token_type is invalid`.

# ── Authorization server 1: the agent chain (api://agentcore) ────────────────
# Created by deploy/00_create_okta_apps.py. Mints T_user at sign-in and
# T_gateway via the OBO exchange. Two custom scopes: agent.access, tools.access.
# Populated by 00_*.
AGENTCORE_AS_ID=
AGENTCORE_AS_ISSUER=
AGENTCORE_AUDIENCE=api://agentcore

# ── Authorization server 2: the resource (api://todo) ───────────────────────
# Created by deploy/00_create_okta_apps.py. Redeems the ID-JAG at leg 2 and
# mints T_tool. Kept SEPARATE from AS 1 on purpose: the todo API trusts only
# this issuer, which is what makes the agent's tokens unusable against it.
# Its access policy must allow the `jwt-bearer` grant and list the AI Agent's
# wlp… client id. Populated by 00_*.
RESOURCE_AS_ID=
RESOURCE_AS_ISSUER=
RESOURCE_AUDIENCE=api://todo
RESOURCE_SCOPE=todos.read

# ── App 1: Login app — the user signs in here ───────────────────────────────
# OIDC web app, authorization_code + PKCE. The BFF is a confidential client.
# Populated by 00_*.
LOGIN_CLIENT_ID=
LOGIN_CLIENT_SECRET=

# ── App 2: Agent app — the OBO exchange at hop C ────────────────────────────
# Okta API Services app with the Token Exchange grant, DPoP OFF (AgentCore
# Identity does not sign DPoP proofs). AgentCore Identity holds this secret;
# the agent never sees it. Populated by 00_*.
AGENT_APP_CLIENT_ID=
AGENT_APP_CLIENT_SECRET=

# ── App 3: AI Agent (wlp…) — the ID-JAG legs at hop D ──────────────────────
# SET ME, MANUAL. The Admin Console is the only path: Directory -> AI Agents ->
# Register AI Agent -> Register manually. See IDP_SETUP_OKTA.md. You need:
#   1. Credentials = Public key / Private key; paste scripts/keys/okta_public_jwk.json
#      (run `python scripts/gen_keypair.py` first)
#   2. Delegations -> Add caller: caller = the Login app, on behalf of = User,
#      authorization server = the ORG server (NOT a custom AS — leg 1 runs there)
#   3. Resource connections -> Add: type = Authorization server -> AS 2 above,
#      scope todos.read
#   4. Actions -> Activate (a STAGED agent fails every call with invalid_client)
# Then copy the AI Agent id (wlp…) and the key's kid.
AI_AGENT_CLIENT_ID=
AI_AGENT_KEY_KID=

# Where the AI Agent's private key lives at runtime. The interceptor signs the
# client assertion with it; prefer KMS so the material is never readable.
#   kms    — AI_AGENT_KMS_KEY_ARN, created by deploy/01_create_providers.py
#   secret — AI_AGENT_KEY_SECRET_ID in Secrets Manager (simpler, less strict)
AI_AGENT_KEY_MODE=kms
AI_AGENT_KMS_KEY_ARN=
AI_AGENT_KEY_SECRET_ID=

# ── Scopes (defaults match the deploy scripts) ──────────────────────────────
# agent.access — T_user: may invoke the runtime
# tools.access — T_gateway: may call the gateway (minted by the OBO exchange)
# todos.read   — T_tool: may read the todo API (minted by ID-JAG leg 2)
SCOPE_AGENT_ACCESS=agent.access
SCOPE_TOOLS_ACCESS=tools.access

# ── Frontend (the BFF) ──────────────────────────────────────────────────────
FRONTEND_HOST=localhost
FRONTEND_PORT=8000
FRONTEND_REDIRECT_URI=http://localhost:8000/auth/callback
# SET ME: python -c 'import secrets;print(secrets.token_hex(32))'
FRONTEND_SESSION_SECRET=

# ── AgentCore Runtime ───────────────────────────────────────────────────────
# AgentCore CLI rules: <= 23 chars, starts with a letter, alphanumeric only.
AGENT_RUNTIME_NAME=xaaTodoAgent
# Optional model override.
MODEL_ID=

# ── Observability ───────────────────────────────────────────────────────────
# Retention for the gateway, interceptor, resource and runtime log groups.
LOG_RETENTION_DAYS=14
# DEBUG makes authorizer and Cedar denials say WHY. Keep it on for the demo.
GATEWAY_EXCEPTION_LEVEL=DEBUG

# ── Populated by the deploy scripts — leave blank ───────────────────────────
GATEWAY_ID=
GATEWAY_URL=
GATEWAY_MCP_URL=
GATEWAY_SERVICE_ROLE_ARN=
AGENT_OBO_PROVIDER_ARN=
POLICY_ENGINE_ID=
INTERCEPTOR_LAMBDA_ARN=
RESOURCE_LAMBDA_NAME=
RESOURCE_API_URL=
# From `agentcore status`. MUST end with ?qualifier=DEFAULT or the invoke 404s.
AGENT_RUNTIME_INVOKE_URL=
AGENT_RUNTIME_ARN=
