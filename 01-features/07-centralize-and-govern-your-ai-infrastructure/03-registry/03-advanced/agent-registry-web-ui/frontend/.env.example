# AWS Agent Registry UI - environment config.
# These are PUBLIC identifiers only (safe to ship in a static bundle).
# Copy to `.env` (or `.env.local`) and fill from your deployed foundation
# (the CloudFormation stack outputs in deploy/cognito-stack.yaml).

VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_EXAMPLE
VITE_USER_POOL_CLIENT_ID=EXAMPLECLIENTID
VITE_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000

# Set once the registry is created (deploy/setup/03-registry.sh up writes both).
VITE_REGISTRY_ID=

# How the registry authorizes CONSUMER (discovery) access. This MUST match the
# registry's own discoveryConfiguration.authorizerType, which is immutable:
#   CUSTOM_JWT (default) - discovery goes through the registry's MCP endpoint with
#                          the signed-in user's Cognito access token as a bearer
#                          token. Same endpoint + token you give Kiro / Quick.
#   AWS_IAM              - discovery uses the SigV4 data-plane SDK client with the
#                          persona-scoped IAM role.
# Control-plane calls (publish, approve, tag) always use IAM either way.
VITE_REGISTRY_AUTH_MODE=CUSTOM_JWT

# --- Sample MCP server on AgentCore Gateway (deploy/setup/06-sample-mcp-gateway.sh) ---
# All three are OPTIONAL. They only prefill the record wizard's "Source &
# authentication" step; the app works without them.
#
# ARN of an AgentCore Identity OAuth 2.0 credential provider. This sample creates one
# against the SAME Cognito user pool as the app (machine-to-machine, client_credentials),
# so a record that synchronizes its descriptor from a protected endpoint can get a
# bearer token with nothing to configure. It becomes the wizard's default credential.
VITE_OAUTH_CREDENTIAL_PROVIDER_ARN=
# Scopes requested with the client_credentials grant, e.g. sample-mcp/invoke
VITE_OAUTH_CREDENTIAL_PROVIDER_SCOPES=
# MCP endpoint of the sample gateway, offered as a one-click source URL in the wizard.
VITE_SAMPLE_GATEWAY_URL=
