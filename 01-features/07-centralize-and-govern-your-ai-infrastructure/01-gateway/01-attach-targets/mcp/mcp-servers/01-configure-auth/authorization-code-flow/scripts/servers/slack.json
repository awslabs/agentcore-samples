{
  "name": "slack",
  "displayName": "Slack",
  "authModel": "oauth_app",
  "vendor": "CustomOauth2",
  "providerConfigKey": "customOauth2ProviderConfig",
  "clientIdEnv": "SLACK_CLIENT_ID",
  "clientSecretEnv": "SLACK_CLIENT_SECRET",
  "discoveryUrl": "https://mcp.slack.com/.well-known/oauth-authorization-server",
  "endpoint": "https://mcp.slack.com/mcp",
  "scopes": [
    "search:read.public",
    "search:read.private",
    "search:read.users",
    "search:read.files",
    "channels:history",
    "channels:read",
    "groups:history",
    "groups:read",
    "im:history",
    "im:read",
    "mpim:history",
    "mpim:read",
    "chat:write",
    "users:read",
    "users:read.email",
    "files:read",
    "files:write",
    "reactions:read",
    "reactions:write",
    "emoji:read",
    "canvases:read",
    "canvases:write",
    "lists:read",
    "lists:write"
  ],
  "toolSchema": "../slack/slack.json",
  "demoTool": "slack_search_public",
  "demoArgs": { "query": "hello" },
  "appSettingsUrl": "https://api.slack.com/apps",
  "resourcePrefix": "slack"
}
