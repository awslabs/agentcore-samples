    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "~24.13.3",
    "aws-cdk": "2.1149.0",
    "prettier": "~3.9.5",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws/agentcore-cdk": "1.2.0",
    "aws-cdk-lib": "2.278.0",
    "constructs": "~10.7.0"
  }
}
