{
  "name": "agentcore-cdk-app",
  "version": "0.1.0",
  "bin": {
    "cdk": "dist/bin/cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "npm run build && node --test test/*.test.cjs",
