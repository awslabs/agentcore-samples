# OpenAI models on Amazon Bedrock
AWS_REGION=us-east-1
BEDROCK_OPENAI_MODEL=openai.gpt-5.5
BEDROCK_OPENAI_WEB_SEARCH_ENABLED=false
OPENAI_REASONING_EFFORT=medium

# AgentCore Payments data-plane resources
PAYMENT_MANAGER_ARN=
PAYMENT_INSTRUMENT_ID=
PAYMENT_SESSION_ID=
PAYMENT_USER_ID=

# Exact HTTPS merchant hosts the payment tool may call.
PAID_RESEARCH_ALLOWED_HOSTS=x402-test.genesisblock.ai,sandbox.node4all.com
PAID_RESEARCH_URL=https://x402-test.genesisblock.ai/api/market-news
