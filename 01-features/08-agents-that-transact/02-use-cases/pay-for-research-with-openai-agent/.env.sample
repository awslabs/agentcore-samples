# OpenAI models on Amazon Bedrock
AWS_REGION=us-east-1
BEDROCK_OPENAI_MODEL=openai.gpt-5.5
BEDROCK_OPENAI_WEB_SEARCH_ENABLED=false
OPENAI_REASONING_EFFORT=medium

# AgentCore Payments data-plane resources
PAYMENT_MANAGER_ARN=
PAYMENT_INSTRUMENT_ID=
PAYMENT_SESSION_ID=
PAYMENT_USER_ID=

# Exact HTTPS merchant hosts the payment tool may call.
PAID_RESEARCH_ALLOWED_HOSTS=x402-test.genesisblock.ai
PAID_RESEARCH_URL=https://x402-test.genesisblock.ai/api/market-news

# Approved recipient and per-payment cap in Base Sepolia USDC base units.
# 10000 base units = 0.01 test USDC; the default merchant charges 2000.
PAID_RESEARCH_ALLOWED_RECIPIENTS=0xA27f7cB624B57C79d7F9de03ae9F5C705c2858dB
PAID_RESEARCH_MAX_AMOUNT=10000
