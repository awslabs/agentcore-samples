# Benchmark configuration — copy to `.env` and fill in.
# run_scenario.sh sources this before driving load_ramp.py.

AWS_REGION=us-east-1

# --- AgentCore Runtime (container, from infrastructure/deploy-agentcore.sh) ---
# arn:aws:bedrock-agentcore:us-west-2:<account>:runtime/ac_ctn_x_lambda_agent_<size>_<version>-XXXX
#
# You can keep every size/version you've deployed here at once — run_scenario.sh
# picks which one to use via IMAGE_SIZE and AGENTCORE_PLATFORM_VERSION
# (AGENTCORE_MANAGED_COMPUTE_VERSION still works as a deprecated alias),
# e.g. `IMAGE_SIZE=750mb AGENTCORE_PLATFORM_VERSION=V2 ./run_scenario.sh 1 agentcore`
# reads AGENTCORE_ARN_750MB_V2 below (falling back to a less specific name, and
# finally to plain AGENTCORE_ARN, if the exact combination isn't set — see
# run_scenario.sh's resolve_arn).
AGENTCORE_ARN=
# AGENTCORE_ARN_200MB_V1=
# AGENTCORE_ARN_200MB_V2=
# AGENTCORE_ARN_500MB_V1=
# AGENTCORE_ARN_500MB_V2=
# AGENTCORE_ARN_750MB_V1=
# AGENTCORE_ARN_750MB_V2=
# AGENTCORE_ARN_1GB_V1=
# AGENTCORE_ARN_1GB_V2=
# AGENTCORE_ARN_2GB_V1=
# AGENTCORE_ARN_2GB_V2=

# --- AgentCore Runtime (direct code / zip, from infrastructure/deploy-agentcore-zip.sh) ---
# arn:aws:bedrock-agentcore:us-west-2:<account>:runtime/ac_zip_x_lambda_bench_agent_<version>-XXXX
# Same idea, no size (zip has none): AGENTCORE_PLATFORM_VERSION=V1
# ./run_scenario.sh 1 agentcore-zip reads AGENTCORE_ZIP_ARN_V1 below, falling
# back to plain AGENTCORE_ZIP_ARN if unset.
AGENTCORE_ZIP_ARN=
# AGENTCORE_ZIP_ARN_V1=
# AGENTCORE_ZIP_ARN_V2=

QUALIFIER=DEFAULT
PROMPT=ping          # payload sent to the echo endpoint

# COLD_FIELD=        # optional: extra JSON key holding the cold-start flag
# NO_TEARDOWN=false  # true = leave sessions running after the test

# Client-side dispatch capacity. If a run stops with stop_reason
# "generator-limited", the load generator (not AgentCore) was the bottleneck —
# raise this. load_ramp.py derives a default from the offered rate; this
# overrides it.
# RAMP_STEP_WORKERS=512
