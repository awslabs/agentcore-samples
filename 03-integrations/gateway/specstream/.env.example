# SpecStream API key (required for openapi mode; optional for mcp-passthrough deploy)
# Create a key under Agents & API at https://specstream.ai/workspace
SPECSTREAM_API_KEY=your-specstream-api-key

# Gateway target mode: "openapi" (stored API_KEY in token vault) or "mcp-passthrough"
SPECSTREAM_MODE=openapi

# AWS configuration
AWS_REGION=us-east-1
MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
